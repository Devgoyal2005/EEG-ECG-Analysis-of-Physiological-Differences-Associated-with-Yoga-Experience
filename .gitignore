# ==========================================
# Git Ignore Configuration
# EEG-ECG Yoga Analysis Platform (MP2026CSE86)
# ==========================================

# 1. Credentials & Environment
backend/.env
.env
*.env.local

# 2. Large Raw Bio-Signal Data (Do NOT commit 20+ GB of .eeg files)
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/raw/.cache/
*.eeg
*.part
*.incomplete
*.mp4
*.avi
*.mkv
*.mov

# Keep results and figures
!backend/data/results/
!backend/data/results/*.xlsx

# 3. Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# 4. Node.js & Frontend Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. IDE & Operating System Files
.idea/
.vscode/
*.swp
*.swo
*~
~$*
.DS_Store
Thumbs.db
desktop.ini

# 6. Antigravity System Generated Cache
.system_generated/
